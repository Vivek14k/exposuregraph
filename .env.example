# ExposureGraph Environment Configuration Example
# Copy this file to .env and customize as needed.

# Application Configuration
APP_ENV=development
DEBUG=False
PORT=8000
HOST=127.0.0.1

# Authentication and browser protections
# Development may omit SESSION_SECRET; an ephemeral key is generated per process.
# Production must use a stable random value of at least 32 characters.
SESSION_SECRET=
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=False
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# demo_attestation is local-only; production must use dns_txt.
DOMAIN_AUTH_MODE=demo_attestation
MAX_ACTIVE_SCANS_PER_USER=2
SCAN_EXECUTION_MODE=inline
SCAN_WORKER_POLL_SECONDS=1.0
LOGIN_RATE_LIMIT=8
LOGIN_RATE_WINDOW_SECONDS=900
USER_RATE_LIMIT=120
USER_RATE_WINDOW_SECONDS=60

# Database Configuration (SQLite default for local development, or PostgreSQL URL)
DATABASE_URL=sqlite:///./exposuregraph.db

# Security & Scanning limits
SCAN_TIMEOUT_SECONDS=45
MAX_SUBDOMAINS_TO_ENUMERATE=25

# Gnani.ai Prisma STT Integration
# Provide your Gnani API Key to enable voice command transcription.
GNANI_API_KEY=
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_MODEL=prisma-v3.0
GNANI_LANGUAGE_CODE=indic-auto

# Gnani.ai Timbre TTS Integration
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Nalini
GNANI_TTS_LANGUAGE=en-IN

# Gemini LLM Brain - powers the conversational assistant
# Get a key at https://aistudio.google.com/apikey
# Without this, the assistant falls back to deterministic templates.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Production examples (set in the deployment environment; never commit values):
# APP_ENV=production
# DEBUG=False
# COOKIE_SECURE=True
# DOMAIN_AUTH_MODE=dns_txt
# SESSION_SECRET=<generate at least 32 random characters>
# CORS_ORIGINS=https://your-frontend.example
# DATABASE_URL=postgresql+psycopg://user:password@database:5432/exposuregraph
